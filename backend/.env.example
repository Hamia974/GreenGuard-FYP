# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DATABASE_NAME=greenguard_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- JWT ---
JWT_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=10
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- JWT cookies (browser sessions -- see docs/AUTHENTICATION.md) ---
# Secure defaults to True whenever DEBUG=False. SameSite=Lax works when the
# frontend and API share a registrable domain (localhost:3000 -> localhost:8000,
# app.example.com -> api.example.com); use None (HTTPS only) for a fully
# cross-site deployment. Leave the domain unset for host-only cookies.
# JWT_COOKIE_SECURE=
JWT_COOKIE_SAMESITE=Lax
# JWT_COOKIE_DOMAIN=

# --- CORS ---
# Explicit origins only ('*' is rejected because credentials are allowed).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- CSRF (cookie-authenticated API requests and the Django admin) ---
# Defaults to CORS_ALLOWED_ORIGINS when left unset (commented out). Only set
# this if another trusted origin (e.g. a separately hosted admin) needs it --
# note an explicitly empty value here disables the fallback, so leave the
# line commented rather than blank.
# CSRF_TRUSTED_ORIGINS=

# --- Email verification ---
EMAIL_VERIFICATION_MAX_AGE_HOURS=48

# --- Email (password reset + email verification; the console backend prints
# emails to the terminal -- use an SMTP backend in production) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@greenguard.local

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:3000

# --- AI Integration ---
ENABLE_MOCK_AI=True

# --- Module 3: Weather Risk Engine ---
# Not exposed to the frontend directly -- only this backend calls it.
# Ignored while ENABLE_MOCK_AI=True above (a fixed mock response is used
# instead, so the module does not need to be running for local development).
# Module 3 is NOT deployed -- it runs locally. Start it from
# ai/Weather_Module/Weather_Module/api with `python main.py` (port 8001);
# it calls the Open-Meteo API itself.
WEATHER_MODULE_URL=http://localhost:8001
WEATHER_MODULE_REQUEST_TIMEOUT_SECONDS=90
WEATHER_MODULE_HEALTH_TIMEOUT_SECONDS=3

# --- Module 2: Soil & Nutrient / "Stress Module" ---
# Not exposed to the frontend directly -- only this backend calls it.
# Ignored while ENABLE_MOCK_AI=True above (a fixed mock response is used
# instead, so the module does not need to be running for local development).
# AI team's official live URL (Render) -- see ai/BACKEND_HANDOFF.md.
STRESS_MODULE_URL=https://greenguardai-gba4.onrender.com
STRESS_MODULE_REQUEST_TIMEOUT_SECONDS=90
STRESS_MODULE_HEALTH_TIMEOUT_SECONDS=10
# To run the AI team's zip locally instead (ai/Stress_Module), use:
# STRESS_MODULE_URL=http://localhost:8002
# STRESS_MODULE_REQUEST_TIMEOUT_SECONDS=30

# --- Module 1: Disease Detection (live service, see ai/API_CONTRACT.md) ---
# Not exposed to the frontend directly -- only this backend calls it.
# Ignored while ENABLE_MOCK_AI=True above (a fixed mock response is used
# instead, so the module does not need to be running for local development).
# AI team's official live URL (Render).
DISEASE_MODULE_URL=https://gg-module1.onrender.com
DISEASE_MODULE_REQUEST_TIMEOUT_SECONDS=60
DISEASE_MODULE_HEALTH_TIMEOUT_SECONDS=5
# Required on every Module 1 /v1/* request as the X-API-Key header. Get the
# real value from the AI team -- never commit it, never put it in frontend
# code, and never give it a real value in this .example file.
GREENGUARD_API_KEY=

# --- Farm location lookup (address -> latitude/longitude) ---
# Used only by POST /api/v1/farms/geocode/ for the Farm form; not an AI
# module and not affected by ENABLE_MOCK_AI. Providers:
#   open_meteo -- no key needed; free for NON-commercial use only
#                 (https://open-meteo.com/en/terms). Fine for development/FYP.
#   google     -- Google Maps Platform Geocoding API; best for full Pakistani
#                 addresses/landmarks. Needs a SERVER key (restrict it to the
#                 Geocoding API, and by server IP in production). Never put it
#                 in frontend code or give it a real value in this file.
GEOCODING_PROVIDER=open_meteo
GEOCODING_COUNTRY_CODE=PK
GEOCODING_REQUEST_TIMEOUT_SECONDS=10
GOOGLE_MAPS_GEOCODING_API_KEY=

# --- Rate Limiting (disabled automatically under `manage.py test`) ---
THROTTLE_RATE_ANON=30/min
THROTTLE_RATE_USER=120/min
THROTTLE_RATE_AUTH=10/min
THROTTLE_RATE_AUTH_REFRESH=30/min
THROTTLE_RATE_GEOCODE=20/min

# --- Production-only security hardening (applied only when DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
