# Root-level variables used only by docker-compose.yml for container
# orchestration (the Postgres service's own credentials, and the frontend
# build-time API URL). Copy to .env and fill in real values; never commit
# .env. Under Docker Compose the DATABASE_* values below are also passed to
# the backend container, overriding backend/.env, so both sides always use
# the same credentials. The backend's full runtime configuration lives in
# backend/.env (see backend/.env.example) and the frontend's dev-server
# configuration in frontend/.env.local (see frontend/.env.local.example).

DATABASE_NAME=greenguard_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=GreenGuard
